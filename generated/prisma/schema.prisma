generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  price        String
  description  String
  category     String //Category
  rating       Float
  numReviews   Int
  countInStock Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

